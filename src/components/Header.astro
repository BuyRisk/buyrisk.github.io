---
import ThemeToggle from "./ThemeToggle.astro";
import { TOOLS } from "../data/tools";

type NavItem = { href: string; label: string; children?: typeof TOOLS };

const navItems: NavItem[] = [
  { href: "/", label: "Home" },
  { href: "/tools", label: "Portfolio Playground", children: TOOLS },
  { href: "/about", label: "About" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Buy Risk home">
      <span class="brand-mark" aria-hidden="true">△</span>
      <span class="brand-name">Buy&nbsp;Risk</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {
        navItems.map((item) =>
          item.children ? (
            <div class="nav-item nav-dropdown">
              <a
                href={item.href}
                class:list={["nav-link", { active: isActive(item.href) }]}
                aria-current={isActive(item.href) ? "page" : undefined}
                aria-haspopup="true"
              >
                {item.label}
                <svg
                  class="nav-caret"
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </a>
              <ul class="nav-menu">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class:list={["nav-menu-link", { active: isActive(child.href) }]}
                      aria-current={isActive(child.href) ? "page" : undefined}
                    >
                      <span class="nav-menu-title">{child.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={["nav-link", { active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          )
        )
      }
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: saturate(160%) blur(8px);
    border-bottom: var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-height: 4rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-decoration: none;
  }
  .brand-mark {
    color: var(--color-accent);
    font-size: 0.9em;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-left: auto;
    flex-wrap: wrap;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-sans);
    font-size: var(--step-0);
    color: var(--color-text-soft);
    text-decoration: none;
    padding: 0.35rem 0.6rem;
    border-radius: 7px;
    transition: color var(--transition), background var(--transition);
  }
  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-surface-alt);
  }
  .nav-link.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* Dropdown */
  .nav-item {
    position: relative;
  }
  .nav-caret {
    transition: transform var(--transition);
    opacity: 0.7;
  }
  .nav-dropdown:hover .nav-caret,
  .nav-dropdown:focus-within .nav-caret {
    transform: rotate(180deg);
  }
  /* Invisible bridge so the menu doesn't close when crossing the gap. */
  .nav-dropdown:hover::after,
  .nav-dropdown:focus-within::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 0.6rem;
  }
  .nav-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 60;
    min-width: 17rem;
    max-width: calc(100vw - 2rem);
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    display: grid;
    gap: 0.1rem;
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity var(--transition), transform var(--transition);
  }
  .nav-dropdown:hover .nav-menu,
  .nav-dropdown:focus-within .nav-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-menu-link {
    display: block;
    padding: 0.5rem 0.6rem;
    border-radius: 7px;
    text-decoration: none;
    color: var(--color-text);
  }
  .nav-menu-link:hover {
    background: var(--color-surface-alt);
  }
  .nav-menu-link.active {
    background: var(--color-accent-soft);
  }
  .nav-menu-title {
    display: block;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--step-0);
  }
  .nav-menu-link.active .nav-menu-title {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-menu {
      transition: none;
    }
  }
</style>
