---
// Renders a Date as a semantic <time> element ("August 17, 2026" with an ISO
// datetime attribute). UTC so the label doesn't shift with the build machine.
interface Props {
  date: Date;
}
const { date } = Astro.props;
const iso = date.toISOString();
const label = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<time datetime={iso}>{label}</time>
