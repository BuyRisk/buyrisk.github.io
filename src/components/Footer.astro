---
// Site-wide footer: brand tagline, section nav, and the educational-only
// disclaimer. Static, no props.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-brand">Buy&nbsp;Risk</p>
      <p class="footer-tagline">
        Plain-language investing education. Learn how risk and return
        actually work.
      </p>
    </div>
    <nav class="footer-nav" aria-label="Footer">
      <a href="/tools">Portfolio Playground</a>
      <a href="/personal-finance">Personal Finance</a>
      <a href="/info">Info</a>
      <a href="/about">About</a>
    </nav>
  </div>
  <div class="container footer-legal">
    <p>© {year} Buy Risk. Educational content only, not financial advice.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-xl);
    border-top: var(--border);
    background: var(--color-surface);
    padding-block: var(--space-lg) var(--space-md);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    justify-content: space-between;
    align-items: start;
  }
  .footer-brand {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--step-1);
    margin: 0 0 0.25rem;
  }
  .footer-tagline {
    color: var(--color-text-soft);
    max-width: 40ch;
    margin: 0;
  }
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: var(--font-sans);
  }
  .footer-nav a {
    color: var(--color-text-soft);
    text-decoration: none;
  }
  .footer-nav a:hover {
    color: var(--color-accent);
  }
  .footer-legal {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: var(--border);
    color: var(--color-muted);
    font-size: var(--step--1);
  }
  .footer-legal p {
    margin: 0;
  }
</style>
