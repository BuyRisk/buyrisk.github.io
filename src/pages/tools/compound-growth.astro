---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CompoundGrowthExplorer from "../../components/CompoundGrowthExplorer.tsx";
import NextTool from "../../components/NextTool.astro";
---

<BaseLayout
  title="Compound Growth Explorer"
  description="An interactive tool: adjust your starting amount, contributions, return, and time horizon to see how an investment compounds."
>
  <section class="container tool-intro">
    <p class="eyebrow">Interactive Tool</p>
    <h1>Compound Growth Explorer</h1>
    <p class="lede">
      Adjust your starting amount, monthly contribution, expected return, and
      time horizon to see how an investment could grow — and watch how much of
      the final balance comes from your contributions versus compounding itself.
    </p>
  </section>

  <section class="container tool-host">
    <div class="tool-frame">
      <CompoundGrowthExplorer client:load />
    </div>
  </section>

  <section class="container tool-more">
    <p>
      Curious why the curve bends the way it does? Read
      <a href="/blog/the-magic-of-compounding/">The Quiet Magic of Compounding</a>,
      or head to the <a href="/tools/portfolio">Portfolio Diversification Lab</a>
      to see how risk and return interact.
    </p>
  </section>

  <NextTool current="/tools/compound-growth" />
</BaseLayout>

<style>
  .tool-intro {
    padding-block: var(--space-lg) var(--space-md);
    max-width: var(--measure);
  }
  .lede {
    font-size: var(--step-1);
    color: var(--color-text-soft);
    line-height: 1.5;
  }
  .tool-frame {
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius);
    padding: var(--space-md);
    box-shadow: var(--shadow);
  }
  .tool-more {
    margin-top: var(--space-lg);
    max-width: var(--measure);
    color: var(--color-text-soft);
  }
</style>

<style is:global>
  /* Styles for the CompoundGrowthExplorer React island. Global so they reach
     the client-rendered component markup. */
  .cge {
    display: grid;
    gap: var(--space-md);
  }
  @media (min-width: 820px) {
    .cge {
      grid-template-columns: 300px 1fr;
      grid-template-areas: "controls output" "note note";
      align-items: start;
    }
    .cge-controls {
      grid-area: controls;
    }
    .cge-output {
      grid-area: output;
    }
    .cge-note {
      grid-area: note;
    }
  }
  .cge-controls {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }
  .cge-field {
    display: grid;
    gap: 0.5rem;
  }
  .cge-mode {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    background: var(--color-surface-alt);
    border-radius: var(--radius);
    padding: 4px;
  }
  .cge-mode button {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    padding: 0.45rem 0.5rem;
    border: none;
    border-radius: 7px;
    background: transparent;
    color: var(--color-text-soft);
    cursor: pointer;
  }
  .cge-mode button.active {
    background: var(--color-surface);
    color: var(--color-accent);
    box-shadow: var(--shadow);
  }
  .cge-goal-note {
    grid-column: 1 / -1;
    margin: var(--space-sm) 0 0;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--color-warn);
  }
  .cge-phase {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-sm);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-bg);
  }
  .cge-phase-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }
  .cge-phase-remove {
    border: none;
    background: transparent;
    color: var(--color-muted);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 0.2rem;
  }
  .cge-phase-remove:hover {
    color: var(--color-error);
  }
  .cge-phase-add {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    padding: 0.5rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-text-soft);
    cursor: pointer;
  }
  .cge-phase-add:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .cge-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--color-text-soft);
  }
  .cge-value-box {
    display: inline-flex;
    align-items: baseline;
    white-space: pre;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.15rem 0.45rem;
    background: var(--color-surface);
    color: var(--color-text);
    transition: border-color var(--transition);
  }
  .cge-value-box:focus-within {
    border-color: var(--color-accent);
  }
  .cge-value-box[data-invalid] {
    border-color: var(--color-error);
  }
  .cge-adorn {
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }
  .cge-value-input {
    width: 6.5em;
    border: none;
    padding: 0;
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    font-weight: 650;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .cge-value-input:focus {
    outline: none;
  }
  .cge-error {
    justify-self: end;
    color: var(--color-error);
    font-family: var(--font-sans);
    font-size: var(--step--1);
  }
  .cge-field input[type="range"] {
    width: 100%;
    accent-color: var(--color-accent);
    cursor: pointer;
  }
  .cge-chart {
    width: 100%;
    height: auto;
    display: block;
  }
  .cge-gridline {
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .cge-axis-label {
    fill: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 11px;
  }
  .cge-area {
    fill: var(--color-accent-soft);
    opacity: 0.7;
  }
  .cge-line {
    fill: none;
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .cge-line--balance {
    stroke: var(--color-accent);
  }
  .cge-line--contributed {
    stroke: var(--color-muted);
    stroke-dasharray: 5 5;
    stroke-width: 2;
  }
  .cge-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--color-text-soft);
  }
  .cge-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .cge-swatch {
    width: 1rem;
    height: 0.35rem;
    border-radius: 2px;
  }
  .cge-swatch--balance {
    background: var(--color-accent);
  }
  .cge-swatch--contributed {
    background: var(--color-muted);
  }
  .cge-stats {
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    margin: var(--space-md) 0 0;
  }
  .cge-stat {
    background: var(--color-surface-alt);
    border-radius: var(--radius);
    padding: var(--space-sm);
  }
  .cge-stat dt {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--color-muted);
    margin-bottom: 0.25rem;
  }
  .cge-stat dd {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 650;
    font-size: var(--step-1);
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }
  .cge-stat--big {
    font-size: var(--step-2) !important;
  }
  .cge-stat--accent {
    color: var(--color-accent) !important;
  }
  .cge-note {
    font-size: var(--step--1);
    color: var(--color-muted);
    font-style: italic;
    margin: 0;
  }
  .cge-retire {
    margin-top: var(--space-md);
    padding: var(--space-md);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-accent-soft);
  }
  .cge-retire-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .cge-retire-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--step-0);
    color: var(--color-text);
  }
  .cge-retire-rate {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--color-text-soft);
  }
  .cge-retire-rate input[type="range"] {
    width: 6rem;
    accent-color: var(--color-accent);
    cursor: pointer;
  }
  .cge-retire-ratebox {
    display: inline-flex;
    align-items: baseline;
    gap: 0.1rem;
    color: var(--color-text);
    font-weight: 700;
  }
  .cge-retire-rateinput {
    width: 3.2rem;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 700;
    text-align: right;
    padding: 0.15rem 0.3rem;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    background: var(--color-surface);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }
  .cge-retire-rateinput:focus {
    outline: none;
    border-color: var(--color-accent);
  }
  .cge-retire-figure {
    margin: 0.4rem 0 0.3rem;
    font-family: var(--font-sans);
    font-size: var(--step-1);
    color: var(--color-text);
  }
  .cge-retire-figure strong {
    color: var(--color-accent);
    font-size: var(--step-2);
  }
  .cge-retire-year {
    color: var(--color-text-soft);
    font-size: var(--step-0);
  }
  .cge-retire-note {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--color-text-soft);
  }
</style>
