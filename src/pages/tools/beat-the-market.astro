---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MarketEfficiencyModule from "../../components/MarketEfficiencyModule.tsx";
import NextTool from "../../components/NextTool.astro";
import Sources from "../../components/Sources.astro";
import "../../styles/simtool.css";
---

<BaseLayout
  title="Can You Outsmart the Market?"
  description="Four angles on the same answer. Predict the next move (you can't), time your entry (you'll miss the best days), deploy a windfall (lump sum usually wins), and hire active managers (most trail the index) — the whole case for indexing."
>
  <section class="container wl-intro">
    <p class="eyebrow">Interactive Tool</p>
    <h1>Can you outsmart the market?</h1>
    <p class="lede">
      Every attempt to beat the market is one of four bets: that you can predict it,
      time it, deploy into it at the perfect moment, or pay someone to pick winners.
      Work through all four and the same answer keeps appearing — which is exactly
      why owning the whole market cheaply is so hard to beat.
    </p>
  </section>

  <section class="container wl-host">
    <MarketEfficiencyModule client:load />
  </section>

  <section class="container wl-explainer">
    <div class="prose">
      <h2>Four bets, one answer</h2>
      <ul>
        <li>
          <strong>Predict it.</strong> In an efficient market, prices already reflect
          what's known, so the next move rides on new information — surprises. Guessing
          them is a coin flip, and a lucky streak isn't skill.
        </li>
        <li>
          <strong>Time it.</strong> The market's best days cluster right next to its
          worst; sit out a handful and decades of growth vanish. Even the "worst
          timer" who only buys at peaks beats the one who waits in cash.
        </li>
        <li>
          <strong>Deploy it.</strong> Got a windfall? Across history, investing it all
          at once usually beats dribbling it in — because the market rises more often
          than it falls, so waiting mostly costs you.
        </li>
        <li>
          <strong>Beat it.</strong> The SPIVA scorecards show most active funds trail
          a simple index over time, and the gap widens the longer you look — after
          fees, the humble index quietly wins.
        </li>
      </ul>
      <p>Educational only, not financial advice.</p>
    </div>
  </section>

  <Sources tool="beat-the-market" />

  <NextTool current="/tools/beat-the-market" />
</BaseLayout>

<style>
  .wl-intro { padding-block: var(--space-lg) var(--space-md); max-width: var(--measure); }
  .lede { font-size: var(--step-1); color: var(--color-text-soft); line-height: 1.5; }
  .wl-explainer { margin-top: var(--space-lg); }
</style>
