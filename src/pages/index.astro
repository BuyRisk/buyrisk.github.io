---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const principles = [
  {
    title: "Risk and return are linked",
    body: "You are paid to bear uncertainty. We show you how that trade actually works — no jargon, no hype.",
  },
  {
    title: "Time is the real advantage",
    body: "Compounding rewards patience. The earlier and longer you invest, the more the math tilts your way.",
  },
  {
    title: "Diversify what you can",
    body: "Some risk earns a premium; some doesn't. Learn to shed the risk you were never paid to hold.",
  },
];
---

<BaseLayout title="Buy Risk">
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Investing education, minus the hype</p>
      <h1 class="hero-title">
        Learn how <span class="accent">risk</span> and
        <span class="accent">return</span> really work.
      </h1>
      <p class="hero-lede">
        Buy Risk is a plain-language guide to investing. We explain the ideas
        that actually move the needle — compounding, diversification, and the
        price of uncertainty — and give you interactive tools to feel them for
        yourself.
      </p>
      <div class="hero-actions">
        <a href="/blog" class="btn btn--primary">Read the blog</a>
        <a href="/tools" class="btn">Try the tools</a>
      </div>
    </div>
  </section>

  <section class="container principles">
    <ul class="grid grid--3 principle-grid">
      {
        principles.map((p) => (
          <li class="card principle">
            <h2>{p.title}</h2>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container spotlight">
    <div class="spotlight-inner card">
      <div>
        <p class="eyebrow">Featured tool</p>
        <h2>Watch your money compound</h2>
        <p>
          Drag a few sliders and see how a starting balance, regular
          contributions, and time combine into something surprisingly large.
          It's the clearest way to understand why investors talk about
          compounding like it's magic.
        </p>
        <a href="/tools/compound-growth" class="btn btn--primary">Open the explorer</a>
      </div>
      <div class="spotlight-visual" aria-hidden="true">
        <svg viewBox="0 0 200 120" role="presentation">
          <path
            d="M4 112 C 60 108, 120 92, 196 12"
            fill="none"
            stroke="var(--color-accent)"
            stroke-width="3"
            stroke-linecap="round"
          ></path>
          <path
            d="M4 112 C 60 108, 120 92, 196 12 L196 116 L4 116 Z"
            fill="var(--color-accent-soft)"
            opacity="0.7"
          ></path>
        </svg>
      </div>
    </div>
  </section>

  <section class="container latest">
    <div class="latest-head">
      <h2 class="section-heading">Latest from the blog</h2>
      <a href="/blog" class="see-all">See all →</a>
    </div>
    <ul class="grid grid--3 post-grid">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="card post-card">
              <h3>{post.data.title}</h3>
              <p class="excerpt">{post.data.description}</p>
              <p class="meta">
                <FormattedDate date={post.data.pubDate} />
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-xl) var(--space-lg);
    border-bottom: var(--border);
    background: radial-gradient(
      110% 80% at 15% 0%,
      var(--color-accent-soft),
      transparent 60%
    );
  }
  .hero-inner {
    max-width: 52rem;
  }
  .hero-title {
    font-size: var(--step-3);
    margin: 0.4rem 0 var(--space-md);
  }
  .accent {
    color: var(--color-accent);
  }
  .hero-lede {
    font-size: var(--step-1);
    color: var(--color-text-soft);
    line-height: 1.5;
    max-width: 46rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .principles {
    margin-top: var(--space-lg);
  }
  .principle-grid {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .principle h2 {
    font-size: var(--step-1);
    margin: 0 0 0.4rem;
  }
  .principle p {
    color: var(--color-text-soft);
    margin: 0;
  }

  .spotlight {
    margin-top: var(--space-lg);
  }
  .spotlight-inner {
    display: grid;
    gap: var(--space-lg);
    padding: var(--space-lg);
    align-items: center;
  }
  @media (min-width: 780px) {
    .spotlight-inner {
      grid-template-columns: 3fr 2fr;
    }
  }
  .spotlight-inner h2 {
    margin: 0.3rem 0 var(--space-sm);
  }
  .spotlight-inner p {
    color: var(--color-text-soft);
    margin-bottom: var(--space-md);
  }
  .spotlight-visual svg {
    width: 100%;
    height: auto;
  }

  .latest {
    margin-top: var(--space-xl);
  }
  .latest-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }
  .section-heading {
    font-size: var(--step-1);
    margin: 0;
  }
  .see-all {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    text-decoration: none;
    white-space: nowrap;
  }
  .post-grid {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-card {
    height: 100%;
  }
  .post-card h3 {
    margin: 0 0 0.4rem;
    font-size: var(--step-1);
  }
  .excerpt {
    color: var(--color-text-soft);
    margin: 0 0 var(--space-sm);
  }
  .meta {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--color-muted);
    margin: 0;
  }
</style>
