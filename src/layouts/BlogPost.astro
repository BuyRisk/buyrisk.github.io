---
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, author, tags } = post.data;
---

<BaseLayout title={title} description={description}>
  <article class="container post">
    <header class="post-header">
      <a href="/blog" class="back-link">← All posts</a>
      <p class="eyebrow">Article</p>
      <h1>{title}</h1>
      <p class="post-lede">{description}</p>
      <div class="post-meta">
        <span>By {author}</span>
        <span aria-hidden="true">·</span>
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated <FormattedDate date={updatedDate} /></span>
            </>
          )
        }
      </div>
      {
        tags.length > 0 && (
          <ul class="tag-list">
            {tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose post-body">
      <slot />
    </div>

    <footer class="post-footer">
      <p class="disclaimer">
        This article is educational and is not personalized financial advice.
      </p>
      <a href="/blog" class="btn">← Back to the blog</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: var(--space-lg);
  }
  .post-header {
    max-width: var(--measure);
    margin-bottom: var(--space-lg);
  }
  .back-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--color-text-soft);
    text-decoration: none;
    margin-bottom: var(--space-md);
  }
  .back-link:hover {
    color: var(--color-accent);
  }
  .post-header h1 {
    margin: 0.3rem 0 var(--space-sm);
  }
  .post-lede {
    font-size: var(--step-1);
    color: var(--color-text-soft);
    line-height: 1.5;
    margin: 0 0 var(--space-md);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--color-muted);
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: var(--space-sm) 0 0;
  }
  .tag {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
  }
  .post-body {
    font-size: var(--step-0);
  }
  .post-footer {
    max-width: var(--measure);
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: var(--border);
  }
  .disclaimer {
    color: var(--color-muted);
    font-size: var(--step--1);
    font-style: italic;
    margin-bottom: var(--space-md);
  }
</style>
